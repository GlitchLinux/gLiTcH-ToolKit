#!/bin/bash
#
# apk-flash-builder v1.0
# Builds a TWRP/OrangeFox flashable ZIP that auto-installs APKs on first boot.
# Requires Magisk on target device (uses /data/adb/service.d/ boot hook).
#
# Flash order: ROM > GApps > Magisk > apk-flash-[timestamp].zip > Reboot
#
# Usage: apk-flash-builder
#        apk-flash-builder /path/to/apk-source /path/to/save
#

set -e

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${CYAN}[*]${NC} $1"; }
ok()    { echo -e "${GREEN}[+]${NC} $1"; }
warn()  { echo -e "${YELLOW}[!]${NC} $1"; }
err()   { echo -e "${RED}[!]${NC} $1"; }
header(){ echo -e "\n${BOLD}$1${NC}"; }

# --- Dependency check ---
for cmd in zip unzip; do
  if ! command -v "$cmd" &>/dev/null; then
    err "'$cmd' is required but not installed."
    exit 1
  fi
done

# --- Prompt or accept arguments ---
header "===== apk-flash-builder v1.0 ====="
echo ""

if [ -n "$1" ]; then
  APK_SOURCE="$1"
else
  read -rp "$(echo -e "${CYAN}APK source directory:${NC} ")" APK_SOURCE
fi

# Expand ~ and resolve path
APK_SOURCE="${APK_SOURCE/#\~/$HOME}"
APK_SOURCE="$(realpath "$APK_SOURCE" 2>/dev/null || echo "$APK_SOURCE")"

if [ ! -d "$APK_SOURCE" ]; then
  err "Source directory does not exist: $APK_SOURCE"
  exit 1
fi

# Count APKs
APK_FILES=("$APK_SOURCE"/*.apk)
if [ ! -f "${APK_FILES[0]}" ]; then
  err "No .apk files found in: $APK_SOURCE"
  exit 1
fi

APK_COUNT=${#APK_FILES[@]}
ok "Found $APK_COUNT APK(s) in source directory"
echo ""

# List APKs with sizes
for apk in "${APK_FILES[@]}"; do
  SIZE=$(du -h "$apk" | awk '{print $1}')
  echo -e "  ${GREEN}-${NC} $(basename "$apk") (${SIZE})"
done
echo ""

if [ -n "$2" ]; then
  SAVE_DIR="$2"
else
  read -rp "$(echo -e "${CYAN}Save ZIP to directory:${NC} ") " SAVE_DIR
fi

SAVE_DIR="${SAVE_DIR/#\~/$HOME}"
SAVE_DIR="$(realpath "$SAVE_DIR" 2>/dev/null || echo "$SAVE_DIR")"

if [ ! -d "$SAVE_DIR" ]; then
  warn "Save directory does not exist, creating: $SAVE_DIR"
  mkdir -p "$SAVE_DIR"
fi

# --- Build in temp workspace ---
TIMESTAMP=$(date '+%Y%m%d-%H%M')
BUILDDIR=$(mktemp -d /tmp/apk-flash-build.XXXXXX)

info "Building in $BUILDDIR ..."

# Create ZIP structure
mkdir -p "$BUILDDIR/META-INF/com/google/android"
mkdir -p "$BUILDDIR/library"

# Copy APKs
info "Copying APKs to library..."
cp "${APK_FILES[@]}" "$BUILDDIR/library/"

# Calculate total size
TOTAL_BYTES=$(du -sb "$BUILDDIR/library" | awk '{print $1}')
TOTAL_MB=$(( (TOTAL_BYTES + 1048575) / 1048576 ))

# Dummy updater-script
echo "# dummy - update-binary handles everything" > "$BUILDDIR/META-INF/com/google/android/updater-script"

# --- Write update-binary ---
cat > "$BUILDDIR/META-INF/com/google/android/update-binary" << 'UPDATEEOF'
#!/sbin/sh
#
# apk-flash - Recovery-flashable APK installer
# Stages APK files for installation on first boot via pm install.
# Safe: does not touch /system, /boot, /vendor, or /recovery.
# Requires Magisk for /data/adb/service.d/ boot hook.
#

OUTFD="$2"
ZIPFILE="$3"

ui_print() {
  echo "ui_print $1" >> /proc/self/fd/$OUTFD
  echo "ui_print" >> /proc/self/fd/$OUTFD
}

set_progress() {
  echo "progress $1 0" >> /proc/self/fd/$OUTFD
}

TMPDIR=/tmp/apk-flash
STAGING=/data/apk-flash-staged
BOOTSCRIPT_DIR=/data/adb/service.d
BOOTSCRIPT="$BOOTSCRIPT_DIR/apk-flash-install.sh"

rm -rf "$TMPDIR"
mkdir -p "$TMPDIR"

ui_print "=============================="
ui_print "  apk-flash installer"
ui_print "=============================="
ui_print " "

# --- Mount /data ---
if ! mountpoint -q /data 2>/dev/null; then
  ui_print "- Mounting /data..."
  mount /data 2>/dev/null
  if ! mountpoint -q /data 2>/dev/null; then
    ui_print "! ERROR: Could not mount /data"
    exit 1
  fi
fi

# --- Cleanup previous installs ---
ui_print "- Cleaning previous remnants..."
CLEANED=0

if [ -d "$STAGING" ]; then
  rm -rf "$STAGING"
  CLEANED=$((CLEANED + 1))
fi

if [ -f "$BOOTSCRIPT" ]; then
  rm -f "$BOOTSCRIPT"
  CLEANED=$((CLEANED + 1))
fi

if [ -f /data/apk-flash-install.log ]; then
  rm -f /data/apk-flash-install.log
  CLEANED=$((CLEANED + 1))
fi

# Clean orphaned /data/app/ entries from broken direct-installs
if [ -d /data/app ]; then
  for ORPHAN in /data/app/*; do
    [ -d "$ORPHAN" ] || continue
    if [ -f "$ORPHAN/base.apk" ] && [ ! -d "$ORPHAN/lib" ] && [ ! -f "$ORPHAN/oat" ]; then
      # Likely orphan from broken direct-copy install
      rm -rf "$ORPHAN"
      ui_print "  > Removed orphan: $(basename "$ORPHAN")"
      CLEANED=$((CLEANED + 1))
    fi
  done
fi

if [ "$CLEANED" -gt 0 ]; then
  ui_print "  > Cleaned $CLEANED item(s)"
else
  ui_print "  > Clean"
fi
ui_print " "

# --- Extract APKs ---
ui_print "- Extracting APKs..."
unzip -o "$ZIPFILE" "library/*" -d "$TMPDIR" 2>/dev/null
if [ $? -ne 0 ]; then
  ui_print "! ERROR: Failed to extract from ZIP"
  exit 1
fi

APK_COUNT=$(find "$TMPDIR/library" -name "*.apk" -type f 2>/dev/null | wc -l)
if [ "$APK_COUNT" -eq 0 ]; then
  ui_print "! No APK files found in library/"
  exit 1
fi

ui_print "- Found $APK_COUNT APK(s)"

# --- Space check ---
TOTAL_SIZE=$(du -sm "$TMPDIR/library" 2>/dev/null | awk '{print $1}')
AVAIL_SPACE=$(df -m /data 2>/dev/null | awk 'NR==2{print $4}')

ui_print "- Payload: ${TOTAL_SIZE}MB"
if [ -n "$AVAIL_SPACE" ]; then
  ui_print "- Free on /data: ${AVAIL_SPACE}MB"
  NEEDED=$((TOTAL_SIZE * 2))
  if [ "$NEEDED" -gt "$AVAIL_SPACE" ]; then
    ui_print "! Not enough space (need ~${NEEDED}MB)"
    ui_print "! Aborting."
    rm -rf "$TMPDIR"
    exit 1
  fi
fi
ui_print " "

# --- Stage APKs ---
set_progress 0.1
ui_print "- Staging APKs..."
mkdir -p "$STAGING"

CURRENT=0
for APK in "$TMPDIR/library/"*.apk; do
  [ -f "$APK" ] || continue
  CURRENT=$((CURRENT + 1))
  ui_print "  [$CURRENT/$APK_COUNT] $(basename "$APK")"
  cp "$APK" "$STAGING/"
  chmod 644 "$STAGING/$(basename "$APK")"
done

chown -R 0:0 "$STAGING"

# --- Magisk check ---
set_progress 0.7
if [ ! -d /data/adb ]; then
  ui_print " "
  ui_print "! WARNING: /data/adb not found"
  ui_print "! Flash Magisk before rebooting!"
  ui_print " "
fi

# --- Boot installer script ---
ui_print "- Creating boot installer..."
mkdir -p "$BOOTSCRIPT_DIR"

cat > "$BOOTSCRIPT" << 'BOOTEOF'
#!/system/bin/sh
STAGING="/data/apk-flash-staged"
LOGFILE="/data/apk-flash-install.log"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOGFILE"; }

log "========================================"
log "apk-flash installer starting"
log "========================================"

TIMEOUT=300
WAITED=0
while [ "$(getprop sys.boot_completed)" != "1" ]; do
  sleep 5
  WAITED=$((WAITED + 5))
  [ "$WAITED" -ge "$TIMEOUT" ] && { log "ERROR: Boot timeout"; exit 1; }
done

sleep 30
log "System booted (${WAITED}s + 30s grace)"

[ ! -d "$STAGING" ] && { log "ERROR: No staging dir"; rm -f "$0"; exit 1; }

INSTALLED=0
FAILED=0
FAILED_LIST=""
TOTAL=$(ls "$STAGING"/*.apk 2>/dev/null | wc -l)

log "Installing $TOTAL APK(s)..."
log ""

for APK in "$STAGING"/*.apk; do
  [ -f "$APK" ] || continue
  BASENAME=$(basename "$APK")
  SIZE=$(du -m "$APK" 2>/dev/null | awk '{print $1}')
  log "[$((INSTALLED + FAILED + 1))/$TOTAL] $BASENAME (${SIZE}MB)"

  OUTPUT=$(pm install -r -g "$APK" 2>&1)
  if [ $? -eq 0 ] && echo "$OUTPUT" | grep -q "Success"; then
    log "  -> OK"
    INSTALLED=$((INSTALLED + 1))
  else
    log "  -> FAIL: $OUTPUT (retrying...)"
    sleep 10
    OUTPUT=$(pm install -r -g "$APK" 2>&1)
    if [ $? -eq 0 ] && echo "$OUTPUT" | grep -q "Success"; then
      log "  -> OK (retry)"
      INSTALLED=$((INSTALLED + 1))
    else
      log "  -> FAILED: $OUTPUT"
      FAILED=$((FAILED + 1))
      FAILED_LIST="$FAILED_LIST $BASENAME"
    fi
  fi
done

log ""
log "========================================"
log "RESULT: $INSTALLED/$TOTAL installed"
[ "$FAILED" -gt 0 ] && log "FAILED: $FAILED -$FAILED_LIST"
log "========================================"

rm -rf "$STAGING"
log "Cleanup done, self-destructing"
rm -f "$0"
exit 0
BOOTEOF

chmod 755 "$BOOTSCRIPT"
chown 0:0 "$BOOTSCRIPT"

rm -rf "$TMPDIR"
set_progress 1.0

ui_print " "
ui_print "=============================="
ui_print "  $APK_COUNT APK(s) staged"
ui_print "=============================="
ui_print " "
ui_print "  Flash order:"
ui_print "  ROM > GApps > Magisk > apk-flash"
ui_print " "
ui_print "  Apps auto-install on first boot."
ui_print "  Log: /data/apk-flash-install.log"
ui_print " "
ui_print "  Reboot now!"
ui_print " "

exit 0
UPDATEEOF

chmod 755 "$BUILDDIR/META-INF/com/google/android/update-binary"

# --- Create info file ---
cat > "$BUILDDIR/apk-flash.info" << EOF
apk-flash - built $(date '+%Y-%m-%d %H:%M')
APK count: $APK_COUNT
Payload: ${TOTAL_MB}MB

Flash order: ROM > GApps > Magisk > apk-flash.zip > Reboot

Apps auto-install on first boot via Magisk service.d hook.
Install log: /data/apk-flash-install.log

Contents:
$(for apk in "${APK_FILES[@]}"; do
  SIZE=$(du -h "$apk" | awk '{print $1}')
  echo "  - $(basename "$apk") ($SIZE)"
done)
EOF

# --- Build ZIP ---
info "Building ZIP (store mode, no compression)..."
ZIPNAME="apk-flash-${TIMESTAMP}-${TOTAL_MB}MB.zip"
ZIPPATH="$SAVE_DIR/$ZIPNAME"

cd "$BUILDDIR"
zip -r -0 "$ZIPPATH" META-INF/ library/ apk-flash.info >/dev/null 2>&1

if [ ! -f "$ZIPPATH" ]; then
  err "Failed to create ZIP!"
  rm -rf "$BUILDDIR"
  exit 1
fi

# --- Cleanup ---
rm -rf "$BUILDDIR"

# --- Done ---
FINAL_SIZE=$(du -h "$ZIPPATH" | awk '{print $1}')
echo ""
header "===== Build complete ====="
echo ""
ok "File: $ZIPPATH"
ok "Size: $FINAL_SIZE"
ok "APKs: $APK_COUNT"
echo ""
info "Transfer to device and flash from recovery."
info "Flash order: ROM > GApps > Magisk > $(basename "$ZIPPATH")"
echo ""
