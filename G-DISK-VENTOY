#!/bin/bash

# Create temporary directory for Ventoy + working files (small stuff only)
TMP_DIR="/tmp/gLiTcH-Ventoy"
mkdir -p "$TMP_DIR"
cd "$TMP_DIR" || exit 1

# Ventoy URLs
VENTOY_URL="https://github.com/ventoy/Ventoy/releases/download/v1.1.12/ventoy-1.1.12-linux.tar.gz"
VENTOY_TARBALL="ventoy-1.1.12-linux.tar.gz"
VENTOY_DIR="ventoy-1.1.12"

# G-Disk variants
GDISK_MINI_URL="https://glitchlinux.wtf/FILES/G-Drive/Gdisk-MIXED-FILES/G-DISK-MINI.zip"
GDISK_FULL_URL="https://glitchlinux.wtf/FILES/G-Drive/Gdisk-MIXED-FILES/G-DISK-VENTOY.zip"

# Minimum required target-disk sizes (in bytes)
#   MINI  zip ~44 MB  -> require >= 256 MB
#   FULL  zip ~10 GB  -> require >= 10.5 GB
MIN_DISK_BYTES_MINI=$((256 * 1024 * 1024))
MIN_DISK_BYTES_FULL=$((10500 * 1024 * 1024))

# Thresholds for the FULL-variant download-location decision
RAM_REQUIRED_BYTES=$((15 * 1024 * 1024 * 1024))   # 15 GiB total RAM => "16 GB class" system
HOME_FREE_REQUIRED_BYTES=$((11 * 1024 * 1024 * 1024))  # 11 GiB free in $HOME

# Check required tools
for tool in wget unzip lsblk awk; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "Error: required tool '$tool' is not installed."
        exit 1
    fi
done

# ---------------------------------------------------------------------------
# Choose G-Disk variant
# ---------------------------------------------------------------------------
echo ""
echo "Select G-Disk content variant to install:"
echo "  1) MINI  (~44 MB zip) - bootloaders (rEFInd, agFM, GRUB2) + iPXE"
echo "                          Minimum target disk: 256 MB"
echo "  2) FULL  (~10 GB zip) - bootloaders + .iso + .wim + partition tools"
echo "                          + Win11 installer + gLiTcH-Linux-KDE + iPXE"
echo "                          Minimum target disk: 10.5 GB"
echo ""

while true; do
    read -rp "Choice [1=MINI / 2=FULL] [Default: 2]: " GDISK_CHOICE
    GDISK_CHOICE=${GDISK_CHOICE:-2}
    case "$GDISK_CHOICE" in
        1|mini|MINI)
            GDISK_VARIANT="MINI"
            GDISK_URL="$GDISK_MINI_URL"
            GDISK_ZIP="G-DISK-MINI.zip"
            MIN_DISK_BYTES=$MIN_DISK_BYTES_MINI
            MIN_DISK_LABEL="256 MB"
            break
            ;;
        2|full|FULL|ventoy|VENTOY)
            GDISK_VARIANT="FULL"
            GDISK_URL="$GDISK_FULL_URL"
            GDISK_ZIP="G-DISK-VENTOY.zip"
            MIN_DISK_BYTES=$MIN_DISK_BYTES_FULL
            MIN_DISK_LABEL="10.5 GB"
            break
            ;;
        *)
            echo "Invalid choice. Enter 1 or 2."
            ;;
    esac
done
echo "Selected variant: $GDISK_VARIANT"

# ---------------------------------------------------------------------------
# Download Ventoy (small, always to /tmp)
# ---------------------------------------------------------------------------
echo ""
echo "Downloading Ventoy v1.1.12..."
wget -q --show-progress -O "$VENTOY_TARBALL" "$VENTOY_URL" || {
    echo "Error: failed to download Ventoy."
    exit 1
}

echo "Extracting Ventoy..."
tar -xzf "$VENTOY_TARBALL"
cd "$VENTOY_DIR" || { echo "Error: extracted directory $VENTOY_DIR not found."; exit 1; }

# ---------------------------------------------------------------------------
# Disk selection
# ---------------------------------------------------------------------------
echo -e "\nAvailable disks:"
lsblk -d -o NAME,SIZE,MODEL,TRAN,TYPE
echo ""

while true; do
    read -rp "Enter the disk to install Ventoy to (e.g. sdb, loop1): " DISK
    DISK="/dev/${DISK}"
    if [ -b "$DISK" ]; then
        DISK_BYTES=$(sudo blockdev --getsize64 "$DISK" 2>/dev/null)
        if [ -z "$DISK_BYTES" ] || [ "$DISK_BYTES" -eq 0 ]; then
            echo "Error: could not determine size of $DISK. Try again."
            continue
        fi
        DISK_GB=$(awk "BEGIN {printf \"%.2f\", $DISK_BYTES/1024/1024/1024}")
        if [ "$DISK_BYTES" -lt "$MIN_DISK_BYTES" ]; then
            echo "Error: $DISK is only ${DISK_GB} GB."
            echo "Variant $GDISK_VARIANT requires at least ${MIN_DISK_LABEL}."
            echo "Please choose a larger disk."
            continue
        fi
        echo "Selected $DISK (${DISK_GB} GB) - size OK for $GDISK_VARIANT."
        break
    else
        echo "Error: $DISK is not a valid block device. Please try again."
    fi
done

# Determine if this is a loop device
IS_LOOP=false
if [[ "$DISK" =~ /dev/loop ]]; then
    IS_LOOP=true
    echo "Detected loop device installation."
fi

# Prompt for partition style
read -rp "Partition style (MBR/GPT) [Default: MBR]: " PART_STYLE
PART_STYLE=${PART_STYLE:-MBR}
if [[ "${PART_STYLE^^}" == "GPT" ]]; then
    PART_OPT="-g"
else
    PART_OPT=""
fi

# Prompt for reserved space
while true; do
    read -rp "Reserved space (e.g. 50M, 50G or FULL) [Default: FULL]: " RESERVED_SPACE
    RESERVED_SPACE=${RESERVED_SPACE:-FULL}
    if [[ "${RESERVED_SPACE^^}" == "FULL" ]]; then
        RESERVE_OPT=""
        break
    elif [[ "$RESERVED_SPACE" =~ ^([0-9]+)([MG])$ ]]; then
        SIZE=${BASH_REMATCH[1]}
        UNIT=${BASH_REMATCH[2]}
        if [[ "$UNIT" == "G" ]]; then
            SIZE=$((SIZE * 1024))
        fi
        RESERVE_OPT="-r $SIZE"
        break
    else
        echo "Invalid format. Please use format like 50M, 50G or FULL."
    fi
done

# Prompt for filesystem
read -rp "Filesystem for data partition (vfat,exfat,ntfs) [Default: ntfs]: " FS_TYPE
FS_TYPE=${FS_TYPE:-ntfs}

# Confirm before proceeding
echo -e "\nAbout to install Ventoy with these settings:"
echo "G-Disk variant: $GDISK_VARIANT"
echo "Disk: $DISK"
echo "Partition style: ${PART_STYLE^^}"
echo "Reserved space: ${RESERVED_SPACE^^}"
echo "Filesystem: ${FS_TYPE,,}"
echo "Data partition label: G-Disk-Vtoy"
read -rp "Continue? (y/n) [Default: y]: " CONFIRM
CONFIRM=${CONFIRM:-y}
if [[ "${CONFIRM,,}" != "y" ]]; then
    echo "Installation cancelled."
    exit 0
fi

# ---------------------------------------------------------------------------
# Run Ventoy installer
# ---------------------------------------------------------------------------
echo "Installing Ventoy to $DISK..."
sudo bash Ventoy2Disk.sh -I $PART_OPT $RESERVE_OPT "$DISK"

# Handle partition naming for loop devices vs regular disks
if $IS_LOOP; then
    VENTOY_PART="${DISK}p1"
else
    VENTOY_PART="${DISK}1"
fi

sleep 2

if [ ! -b "$VENTOY_PART" ]; then
    echo "Error: Partition $VENTOY_PART not found!"
    echo "Trying alternative partition naming..."
    if [ -b "${DISK}1" ]; then
        VENTOY_PART="${DISK}1"
    elif [ -b "${DISK}p1" ]; then
        VENTOY_PART="${DISK}p1"
    else
        echo "Could not find Ventoy data partition. Installation may have failed."
        exit 1
    fi
    echo "Found partition at $VENTOY_PART"
fi

# Unmount if already mounted
MOUNT_POINT="/mnt/ventoy"
sudo umount "$VENTOY_PART" 2>/dev/null

# Format the data partition
echo "Formatting partition with ${FS_TYPE^^} filesystem (label: G-Disk-Vtoy)..."
case "${FS_TYPE,,}" in
    vfat|fat|fat32)
        sudo mkfs.vfat -n "G-Disk-Vtoy" "$VENTOY_PART"
        ;;
    exfat)
        sudo mkfs.exfat -n "G-Disk-Vtoy" "$VENTOY_PART"
        ;;
    ntfs)
        sudo mkfs.ntfs -f -L "G-Disk-Vtoy" "$VENTOY_PART"
        ;;
    *)
        echo "Unknown filesystem, using NTFS as default"
        sudo mkfs.ntfs -f -L "G-Disk-Vtoy" "$VENTOY_PART"
        ;;
esac

# Mount the partition
sudo mkdir -p "$MOUNT_POINT"
echo "Mounting $VENTOY_PART to $MOUNT_POINT..."

case "${FS_TYPE,,}" in
    vfat|fat|fat32)
        sudo mount -o umask=000 "$VENTOY_PART" "$MOUNT_POINT"
        ;;
    *)
        sudo mount "$VENTOY_PART" "$MOUNT_POINT"
        ;;
esac

if ! mountpoint -q "$MOUNT_POINT"; then
    echo "Error: Failed to mount $VENTOY_PART"
    exit 1
fi

# ---------------------------------------------------------------------------
# Decide where to download the G-Disk archive
#
# MINI is small (~44 MB) -> always /tmp.
#
# FULL is ~10 GB. /tmp is tmpfs on many distros, so the download would be
# RAM-bound. Decision tree:
#   1. /tmp is NOT tmpfs (i.e. backed by disk) and has >= 11 GB free -> /tmp
#   2. /tmp is tmpfs and total RAM >= 15 GiB                         -> /tmp
#   3. $HOME has >= 11 GB free                                       -> $HOME
#   4. otherwise                                                     -> direct
#      to mounted Ventoy data partition
# ---------------------------------------------------------------------------

# Resolve the user's home reliably even when running under sudo
REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
[ -z "$REAL_HOME" ] && REAL_HOME="$HOME"

# Detect whether /tmp is tmpfs
TMP_FSTYPE=$(findmnt -n -o FSTYPE --target /tmp 2>/dev/null)
[ -z "$TMP_FSTYPE" ] && TMP_FSTYPE="unknown"

# Total RAM in bytes
RAM_BYTES=$(awk '/MemTotal/ {print $2 * 1024}' /proc/meminfo)
RAM_GB=$(awk "BEGIN {printf \"%.2f\", $RAM_BYTES/1024/1024/1024}")

# Free space helpers (in bytes) using df --output=avail (POSIX 1K blocks)
free_bytes() {
    df -B1 --output=avail "$1" 2>/dev/null | tail -n1 | tr -d ' '
}

TMP_FREE=$(free_bytes /tmp)
HOME_FREE=$(free_bytes "$REAL_HOME")
PART_FREE=$(free_bytes "$MOUNT_POINT")

human_gb() { awk "BEGIN {printf \"%.2f GB\", $1/1024/1024/1024}"; }

echo ""
echo "Download-location analysis:"
echo "  Variant            : $GDISK_VARIANT"
echo "  Total RAM          : $(human_gb "$RAM_BYTES")"
echo "  /tmp filesystem    : $TMP_FSTYPE"
echo "  /tmp free          : $(human_gb "${TMP_FREE:-0}")"
echo "  \$HOME ($REAL_HOME) free : $(human_gb "${HOME_FREE:-0}")"
echo "  Ventoy partition free   : $(human_gb "${PART_FREE:-0}")"

DL_DIR=""
DL_LOC_DESC=""
DL_ON_PARTITION=false

if [ "$GDISK_VARIANT" = "MINI" ]; then
    # Tiny file - just put it in /tmp
    DL_DIR="$TMP_DIR"
    DL_LOC_DESC="/tmp (small download)"
else
    # FULL: 10 GB decision tree
    if [ "$TMP_FSTYPE" != "tmpfs" ] && [ -n "$TMP_FREE" ] && [ "$TMP_FREE" -ge "$HOME_FREE_REQUIRED_BYTES" ]; then
        DL_DIR="$TMP_DIR"
        DL_LOC_DESC="/tmp (disk-backed, $(human_gb "$TMP_FREE") free)"
    elif [ "$TMP_FSTYPE" = "tmpfs" ] && [ -n "$RAM_BYTES" ] && [ "$RAM_BYTES" -ge "$RAM_REQUIRED_BYTES" ]; then
        DL_DIR="$TMP_DIR"
        DL_LOC_DESC="/tmp tmpfs (RAM is $(human_gb "$RAM_BYTES"), enough headroom)"
    elif [ -n "$HOME_FREE" ] && [ "$HOME_FREE" -ge "$HOME_FREE_REQUIRED_BYTES" ]; then
        DL_DIR="$REAL_HOME/.gLiTcH-Ventoy-dl"
        sudo -u "$REAL_USER" mkdir -p "$DL_DIR" 2>/dev/null || mkdir -p "$DL_DIR"
        DL_LOC_DESC="$DL_DIR ($(human_gb "$HOME_FREE") free in \$HOME)"
    else
        # Last resort: download straight onto the mounted Ventoy data partition
        DL_DIR="$MOUNT_POINT"
        DL_ON_PARTITION=true
        DL_LOC_DESC="directly on G-Disk-Vtoy partition ($(human_gb "${PART_FREE:-0}") free)"
        # Sanity check the partition itself can hold the zip (~10 GB)
        if [ -n "$PART_FREE" ] && [ "$PART_FREE" -lt $((10 * 1024 * 1024 * 1024)) ]; then
            echo "Error: not enough free space anywhere to stage the 10 GB download."
            echo "  /tmp tmpfs: $TMP_FSTYPE, RAM: $(human_gb "$RAM_BYTES")"
            echo "  \$HOME free: $(human_gb "${HOME_FREE:-0}")"
            echo "  partition free: $(human_gb "${PART_FREE:-0}")"
            sudo umount "$MOUNT_POINT" 2>/dev/null
            exit 1
        fi
    fi
fi

echo "Chosen download location: $DL_LOC_DESC"
echo ""

# ---------------------------------------------------------------------------
# Download chosen G-Disk archive
# ---------------------------------------------------------------------------
if [ "$GDISK_VARIANT" = "FULL" ]; then
    echo "Downloading $GDISK_ZIP (~10 GB) - this will take a while..."
else
    echo "Downloading $GDISK_ZIP (~44 MB)..."
fi

DL_PATH="$DL_DIR/$GDISK_ZIP"
if $DL_ON_PARTITION; then
    sudo wget --show-progress -O "$DL_PATH" "$GDISK_URL" || {
        echo "Error: failed to download $GDISK_URL"
        sudo rm -f "$DL_PATH"
        sudo umount "$MOUNT_POINT" 2>/dev/null
        exit 1
    }
else
    wget --show-progress -O "$DL_PATH" "$GDISK_URL" || {
        echo "Error: failed to download $GDISK_URL"
        rm -f "$DL_PATH"
        sudo umount "$MOUNT_POINT" 2>/dev/null
        exit 1
    }
fi

ZIP_BYTES=$(stat -c%s "$DL_PATH" 2>/dev/null || echo 0)
echo "Downloaded $GDISK_ZIP ($(human_gb "$ZIP_BYTES"))."

# ---------------------------------------------------------------------------
# Extract to mounted partition
# ---------------------------------------------------------------------------
echo "Extracting $GDISK_ZIP to $MOUNT_POINT (root of G-Disk-Vtoy)..."
sudo unzip -o "$DL_PATH" -d "$MOUNT_POINT" || {
    echo "Error: extraction failed."
    if ! $DL_ON_PARTITION; then
        # leave the zip alone so user can retry
        echo "Zip preserved at $DL_PATH for retry."
    fi
    sudo umount "$MOUNT_POINT" 2>/dev/null
    exit 1
}

# Verify extraction landed something on the partition (basic sanity check)
EXTRACT_FILE_COUNT=$(sudo find "$MOUNT_POINT" -mindepth 1 ! -name "$GDISK_ZIP" 2>/dev/null | wc -l)
if [ "$EXTRACT_FILE_COUNT" -lt 1 ]; then
    echo "Error: extraction completed but partition appears empty."
    sudo umount "$MOUNT_POINT" 2>/dev/null
    exit 1
fi
echo "Extraction verified: $EXTRACT_FILE_COUNT entries on partition."

# ---------------------------------------------------------------------------
# Delete the downloaded zip from wherever it was staged
# ---------------------------------------------------------------------------
if $DL_ON_PARTITION; then
    echo "Removing staged zip from partition: $DL_PATH"
    sudo rm -f "$DL_PATH"
elif [[ "$DL_PATH" == "$REAL_HOME/"* ]]; then
    echo "Removing staged zip from \$HOME: $DL_PATH"
    rm -f "$DL_PATH"
    rmdir "$DL_DIR" 2>/dev/null
else
    rm -f "$DL_PATH"
fi

# ---------------------------------------------------------------------------
# Final cleanup
# ---------------------------------------------------------------------------
echo "Cleaning up..."
sync
cd /
sudo umount "$MOUNT_POINT" 2>/dev/null
rm -rf "$TMP_DIR"

echo ""
echo "Ventoy v1.1.12 installation with gLiTcH customization complete!"
echo "Variant installed: $GDISK_VARIANT"
echo "Data partition label: G-Disk-Vtoy"
echo "Download was staged via: $DL_LOC_DESC"
if [ "$GDISK_VARIANT" = "FULL" ]; then
    echo "You can now add additional ISO files to the G-Disk-Vtoy partition."
else
    echo "MINI variant installed (bootloaders + iPXE only)."
    echo "You can drop your own ISO files onto the G-Disk-Vtoy partition."
fi
