#!/bin/bash

cat > /tmp/git-token-get << 'EOF'
#!/bin/bash
set -e

cd /tmp

# Stop timers/fallbacks from an earlier fetch first. Their cleanup deletes
# /tmp/token-timer, so this must run before the new files are copied in.
sudo pkill -f '^bash /tmp/\.token-timer$' || true
sudo pkill -f '[D]eleting /tmp/\.token in' || true
sudo pkill -f '[t]oken-timer-fallback' || true
sleep 1

sudo rm -f .token .token-timer token*

# Clean startup - check if mounted and clean it properly
if grep -q /tmp/.luks-mount /proc/mounts; then
  echo "[git-token-get] Unmounting leftover mount..."
  sudo umount /tmp/.luks-mount
fi

# Close device if it exists
if sudo cryptsetup status img-luks &>/dev/null; then
  echo "[git-token-get] Closing leftover device..."
  sudo cryptsetup luksClose img-luks
fi

# Remove residual files
sudo rm -rf /tmp/.luks-mount /tmp/TOKEN.img

echo "[git-token-get] Downloading TOKEN image..."

# Download with HTTPS
wget "https://glitchlinux.wtf/FILES/SSH-TOKEN/TOKEN.img"

# Create mount directory
sudo mkdir -p /tmp/.luks-mount

# Open and mount
sudo cryptsetup luksOpen TOKEN.img img-luks
sudo mount /dev/mapper/img-luks /tmp/.luks-mount/

sleep 1

# Extract hidden files (.git-token, .token)
echo "[git-token-get] Extracting tokens..."

cd /tmp/.luks-mount/ && sudo cp -f token-timer.sh /tmp/ && sudo cp -f token-timer /tmp/ && sudo cp -f .token /tmp/ && cd ~

# Proper cleanup
echo "[git-token-get] Cleaning up..."
sudo umount /tmp/.luks-mount
sudo cryptsetup luksClose img-luks
sudo rm -rf /tmp/.luks-mount /tmp/TOKEN.img

# Token binary readable by root only, and wiped after 1h even if never run
sudo chmod 700 /tmp/token-timer
sudo setsid nohup bash -c ': token-timer-fallback; sleep 3600; [ -f /tmp/token-timer ] && head -c 10k /dev/urandom > /tmp/token-timer; rm -f /tmp/token-timer /tmp/token-timer.sh' >/dev/null 2>&1 </dev/null &

# Report
echo "Git-token imported to /tmp/" > /tmp/token-get
ls -lh /tmp/.token >> /tmp/token-get
ls -lh /tmp/token-timer.sh >> /tmp/token-get
ls -lh /tmp/token-timer >> /tmp/token-get
echo ""
cat /tmp/token-get | borderize
sudo rm -f /tmp/token-get
echo ""
read -p "Hit Enter to exit" _
EOF

sudo install -o root -g root -m 755 /tmp/git-token-get /usr/local/bin/git-token-get
sudo rm -f /tmp/git-token-get
clear && /usr/local/bin/git-token-get
