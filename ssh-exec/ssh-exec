#!/usr/bin/env bash
# ssh-exec - execute single commands on remote servers from the local shell
#
# Interactive:  ssh-exec
# Flag mode:    ssh-exec <target> '<command>'
# Key setup:    ssh-exec --setup <target>
#
# Auth order:
#   1. SSH key (preferred, run --setup once per target)
#   2. sshpass fallback, password read from ~/.config/ssh-exec/<target>.pass (chmod 600)

set -o pipefail

VERSION="1.0"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ssh-exec"
KEY_FILE="$HOME/.ssh/id_ed25519"
TIMEOUT=10

# name|user|host|port|label
TARGETS=(
  "glitchserver|x|glitchserver.com|2222|GlitchServer"
  "contabo|x|164.68.108.224|22|Contabo-VPS"
)

SSH_OPTS=(-o ConnectTimeout="$TIMEOUT" -o ServerAliveInterval=15 -o StrictHostKeyChecking=accept-new)

if [ -t 1 ]; then
  G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; C=$'\e[36m'; B=$'\e[1m'; N=$'\e[0m'
else
  G=; R=; Y=; C=; B=; N=
fi

die()  { echo "${R}Error:${N} $*" >&2; exit 2; }
warn() { echo "${Y}Warning:${N} $*" >&2; }

usage() {
  cat <<EOF
ssh-exec v$VERSION - run a single command on a remote server

Usage:
  ssh-exec                         interactive mode
  ssh-exec <target> '<command>'    flag mode
  ssh-exec --setup <target>        generate/install SSH key on target
  ssh-exec --test  <target>        test connection and auth method
  ssh-exec --list                  list targets
  ssh-exec -h | --help

Targets:
  1 | glitch | glitchserver        x@glitchserver.com:2222
  2 | contabo | vps                x@164.68.108.224:22

Password fallback (sshpass):
  echo 'PASSWORD' > $CONF_DIR/<glitchserver|contabo>.pass
  chmod 600 $CONF_DIR/*.pass

Examples:
  ssh-exec contabo 'sudo systemctl restart apache2'
  ssh-exec 1 'df -h /'
EOF
}

resolve_target() {
  case "${1,,}" in
    1|glitch|glitchserver|glitch-server|gs) echo 0 ;;
    2|contabo|contabo-vps|vps)              echo 1 ;;
    *) return 1 ;;
  esac
}

load_target() {
  IFS='|' read -r T_NAME T_USER T_HOST T_PORT T_LABEL <<< "${TARGETS[$1]}"
  PASS_FILE="$CONF_DIR/$T_NAME.pass"
}

key_ok() {
  ssh "${SSH_OPTS[@]}" -o BatchMode=yes -p "$T_PORT" "$T_USER@$T_HOST" true 2>/dev/null
}

check_pass_file() {
  [ -f "$PASS_FILE" ] || return 1
  local perm
  perm=$(stat -c %a "$PASS_FILE" 2>/dev/null)
  [ "$perm" = "600" ] || [ "$perm" = "400" ] || warn "$PASS_FILE has mode $perm, run: chmod 600 $PASS_FILE"
  command -v sshpass >/dev/null || die "sshpass not installed (sudo apt install sshpass)"
  return 0
}

run_remote() {
  local cmd="$1" rc
  local tty=(-T)
  [ -t 0 ] && [ -t 1 ] && tty=(-t)   # tty so remote sudo can prompt

  echo "${C}[Sending${N} ${B}$cmd${N} ${C}to${N} ${B}$T_LABEL${N} ${C}($T_USER@$T_HOST:$T_PORT)]${N}"

  if check_pass_file && ! key_ok; then
    sshpass -f "$PASS_FILE" ssh "${SSH_OPTS[@]}" "${tty[@]}" -p "$T_PORT" "$T_USER@$T_HOST" "$cmd"
  else
    ssh "${SSH_OPTS[@]}" -o BatchMode=yes "${tty[@]}" -p "$T_PORT" "$T_USER@$T_HOST" "$cmd"
  fi
  rc=$?

  case $rc in
    0)   echo "${G}Success ✓${N}" ;;
    255) echo "${R}Failed ✘${N} (ssh error: connection or auth, try: ssh-exec --test $T_NAME)" ;;
    5|6) echo "${R}Failed ✘${N} (sshpass exit $rc: wrong password or host key issue)" ;;
    *)   echo "${R}Failed ✘${N} (remote exit $rc)" ;;
  esac
  return $rc
}

setup_key() {
  [ -f "$KEY_FILE" ] || ssh-keygen -t ed25519 -N "" -f "$KEY_FILE" || die "ssh-keygen failed"
  echo "${C}[Installing key on $T_LABEL ($T_USER@$T_HOST:$T_PORT)]${N}"
  if check_pass_file; then
    sshpass -f "$PASS_FILE" ssh-copy-id "${SSH_OPTS[@]}" -i "$KEY_FILE.pub" -p "$T_PORT" "$T_USER@$T_HOST"
  else
    ssh-copy-id "${SSH_OPTS[@]}" -i "$KEY_FILE.pub" -p "$T_PORT" "$T_USER@$T_HOST"
  fi
  key_ok && echo "${G}Key auth OK ✓${N}" || { echo "${R}Key auth failed ✘${N}"; return 1; }
}

test_target() {
  echo "${C}[Testing $T_LABEL ($T_USER@$T_HOST:$T_PORT)]${N}"
  if key_ok; then
    echo "${G}Key auth OK ✓${N}"
  elif check_pass_file && sshpass -f "$PASS_FILE" ssh "${SSH_OPTS[@]}" -p "$T_PORT" "$T_USER@$T_HOST" true; then
    echo "${Y}Password auth OK (sshpass) - run: ssh-exec --setup $T_NAME${N}"
  else
    echo "${R}No working auth ✘${N}"; return 1
  fi
}

list_targets() {
  local i
  for i in "${!TARGETS[@]}"; do
    load_target "$i"
    printf "  %d. %-13s %s@%s:%s\n" $((i+1)) "$T_LABEL" "$T_USER" "$T_HOST" "$T_PORT"
  done
}

interactive() {
  local sel idx cmd
  echo
  list_targets
  echo
  read -r -p "ssh-exec \$target [1-${#TARGETS[@]}] : " sel
  idx=$(resolve_target "$sel") || die "invalid target: $sel"
  load_target "$idx"
  read -e -r -p "enter \$command : " cmd
  [ -n "$cmd" ] || die "empty command"
  run_remote "$cmd"
}

command -v ssh >/dev/null || die "ssh not installed"
mkdir -p "$CONF_DIR" && chmod 700 "$CONF_DIR"

case "$1" in
  "")            interactive ;;
  -h|--help)     usage ;;
  -l|--list)     list_targets ;;
  -v|--version)  echo "ssh-exec v$VERSION" ;;
  --setup|--test)
    [ -n "$2" ] || die "$1 requires a target"
    idx=$(resolve_target "$2") || die "unknown target: $2"
    load_target "$idx"
    [ "$1" = "--setup" ] && setup_key || test_target ;;
  *)
    idx=$(resolve_target "$1") || { usage; die "unknown target: $1"; }
    load_target "$idx"
    shift
    [ $# -gt 0 ] || die "no command given"
    run_remote "$*" ;;
esac
