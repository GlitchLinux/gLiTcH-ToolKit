#!/bin/bash

# Disk Image Writer Script
# Downloads image and writes to selected storage device with safety confirmation

set -e

IMAGE_URL="https://glitchlinux.wtf/FILES/G-Drive/Gdisk-ext4-100MB.img"
IMAGE_FILE="/tmp/Gdisk-ext4-100MB.img"
DOWNLOAD_DIR="/tmp"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}=== Disk Image Writer ===${NC}\n"

# Step 1: Download image
echo -e "${YELLOW}[1/4]${NC} Downloading image file..."
if [ -f "$IMAGE_FILE" ]; then
    read -p "Image file already exists. Redownload? (y/n): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Using existing image file."
    else
        rm "$IMAGE_FILE"
        wget -q --show-progress "$IMAGE_URL" -O "$IMAGE_FILE"
    fi
else
    wget -q --show-progress "$IMAGE_URL" -O "$IMAGE_FILE"
fi

if [ ! -f "$IMAGE_FILE" ]; then
    echo -e "${RED}Error: Failed to download image file${NC}"
    exit 1
fi

IMAGE_SIZE=$(du -h "$IMAGE_FILE" | cut -f1)
echo -e "${GREEN}Downloaded: $IMAGE_FILE ($IMAGE_SIZE)${NC}\n"

# Step 2: List available devices
echo -e "${YELLOW}[2/4]${NC} Available storage devices:\n"

# Get list of devices
lsblk -dno NAME,SIZE,TYPE,VENDOR,MODEL 2>/dev/null || lsblk -dno NAME,SIZE,TYPE

echo ""
echo "Device categories:"
echo "  - sd*/hd*: Internal/External SATA drives"
echo "  - nvme*: NVMe SSDs"
echo "  - loop*: Loop devices"
echo "  - mmcblk*: SD cards and eMMC"
echo ""

# Step 3: User selects device
echo -e "${YELLOW}[3/4]${NC} Select target device"
read -p "Enter device name (e.g., sdb, nvme0n1, sdc1): " DEVICE

# Validate device exists
if [ ! -b "/dev/$DEVICE" ]; then
    echo -e "${RED}Error: Device /dev/$DEVICE not found${NC}"
    exit 1
fi

# Get device info
DEVICE_SIZE=$(lsblk -dno SIZE "/dev/$DEVICE" 2>/dev/null || echo "Unknown")
DEVICE_NAME=$(lsblk -dno NAME "/dev/$DEVICE" 2>/dev/null || echo "$DEVICE")
DEVICE_PATH="/dev/$DEVICE"

# Step 4: Confirmation
echo -e "\n${RED}=== WRITE CONFIRMATION ===${NC}"
echo "Image file:     $IMAGE_FILE ($IMAGE_SIZE)"
echo "Target device:  $DEVICE_PATH ($DEVICE_SIZE)"
echo ""
echo -e "${RED}WARNING: This will OVERWRITE all data on $DEVICE_PATH${NC}"
echo "This action cannot be undone!"
echo ""

read -p "Type 'YES' to proceed (or anything else to cancel): " CONFIRM

if [ "$CONFIRM" != "YES" ]; then
    echo -e "${YELLOW}Operation cancelled.${NC}"
    exit 0
fi

# Final confirmation
echo -e "\n${YELLOW}[4/4]${NC} Writing image to device..."
echo "Command: dd if=$IMAGE_FILE of=$DEVICE_PATH bs=4M status=progress"
echo ""

# Execute dd with progress
sudo dd if="$IMAGE_FILE" of="$DEVICE_PATH" bs=4M status=progress
RESULT=$?

if [ $RESULT -eq 0 ]; then
    echo -e "\n${GREEN}Successfully wrote image to $DEVICE_PATH${NC}"
    echo "Syncing filesystem..."
    sudo sync
    echo -e "${GREEN}Done!${NC}"
else
    echo -e "\n${RED}Error writing image (exit code: $RESULT)${NC}"
    exit $RESULT
fi
