a#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────────
#  install-glitch-calamares.sh
#
#  Fetches the patched gLiTcH Calamares build (3.3.14-1glitch1) from GitHub
#  and installs it system-wide along with the gLiTcH branding, modules, and
#  desktop launcher.
#
#  The patched build adds:
#    • allowLoopDevices: true   in partition.conf  →  install to /dev/loop*
#
#  Usage:  sudo ./install-glitch-calamares.sh
#
#  Source: https://github.com/GlitchLinux/gLiTcH-Calamares
#
#  Changelog:
#    v13.1 (2026-05-06) — Keep calamares-settings-debian installed.
#      It provides /etc/calamares/modules/{dpkg-unsafe-io,sources-media,
#      sources-media-unmount,bootloader-config,dpkg-unsafe-io-undo,
#      sources-final}.conf which our settings.conf references in the
#      `exec` sequence. Purging it caused "Calamares Initialization Failed"
#      with all six modules listed as failing to load. Our inner zip is
#      now overlaid AFTER the package install so settings.conf and
#      branding override the Debian defaults without dropping the
#      shellprocess module configs.
# ──────────────────────────────────────────────────────────────────────────

set -euo pipefail

# ── Config ────────────────────────────────────────────────────────────────
ZIP_URL="https://github.com/GlitchLinux/gLiTcH-Calamares/raw/refs/heads/main/calamares-glitch-13-build.zip"
WORK_DIR="/tmp/glitch-calamares-install.$$"
DEB_VERSION="3.3.14-1glitch1"

# ── Pretty output ─────────────────────────────────────────────────────────
RED='\033[0;31m'; GRN='\033[0;32m'; YLW='\033[1;33m'; CYA='\033[0;36m'; RST='\033[0m'
info()  { echo -e "${CYA}[*]${RST} $*"; }
ok()    { echo -e "${GRN}[✓]${RST} $*"; }
warn()  { echo -e "${YLW}[!]${RST} $*"; }
die()   { echo -e "${RED}[✗]${RST} $*" >&2; exit 1; }

trap 'rm -rf "$WORK_DIR"' EXIT

# ── Sanity checks ─────────────────────────────────────────────────────────
[[ $EUID -eq 0 ]] || die "Run with sudo: sudo $0"

# Determine the non-root user who invoked sudo (for desktop file ownership).
TARGET_USER="${SUDO_USER:-root}"
TARGET_GROUP="$(id -gn "$TARGET_USER" 2>/dev/null || echo root)"
info "Target user for desktop launcher: ${TARGET_USER}:${TARGET_GROUP}"

command -v curl  >/dev/null || die "curl is required (apt install curl)"
command -v unzip >/dev/null || die "unzip is required (apt install unzip)"

# ── Banner ────────────────────────────────────────────────────────────────
cat <<'BANNER'

   ╔═══════════════════════════════════════════════════════╗
   ║         gLiTcH Calamares Installer — v13.1            ║
   ║   Calamares 3.3.14-1glitch1  +  loop device support   ║
   ╚═══════════════════════════════════════════════════════╝

BANNER

# ── Stage 1: download ─────────────────────────────────────────────────────
mkdir -p "$WORK_DIR"
cd "$WORK_DIR"

info "Downloading build bundle..."
info "  URL: $ZIP_URL"
curl -fL --progress-bar -o calamares-glitch-13-build.zip "$ZIP_URL" \
    || die "Download failed"
ok  "Downloaded $(du -h calamares-glitch-13-build.zip | cut -f1)"

# ── Stage 2: extract ──────────────────────────────────────────────────────
info "Extracting outer bundle..."
unzip -q calamares-glitch-13-build.zip
cd calamares-glitch-13-build

DEB_FILE="calamares_${DEB_VERSION}_amd64.deb"
INNER_ZIP="calamares-glitch-13.zip"

[[ -f "$DEB_FILE"   ]] || die "Missing $DEB_FILE in bundle"
[[ -f "$INNER_ZIP"  ]] || die "Missing $INNER_ZIP in bundle"
ok "Bundle contents verified"

# ── Stage 3: dependencies ─────────────────────────────────────────────────
info "Updating apt cache and installing build/runtime dependencies..."

apt-get update -qq || warn "apt-get update had issues, continuing anyway"

PRE_DEPS=(
    os-prober
    squashfs-tools
    btrfs-progs
    parted
    dosfstools
    e2fsprogs
    cryptsetup
    rsync
    sudo
    util-linux
)
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    "${PRE_DEPS[@]}" 2>&1 | tail -5 || warn "Some pre-deps may not have installed"
ok "Pre-dependencies in place"

# ── Stage 4: handle conflicting / required settings packages ──────────────
# IMPORTANT: We KEEP calamares-settings-debian installed because it ships
# the shellprocess module configs that our settings.conf references:
#   /etc/calamares/modules/dpkg-unsafe-io.conf
#   /etc/calamares/modules/dpkg-unsafe-io-undo.conf
#   /etc/calamares/modules/sources-media.conf
#   /etc/calamares/modules/sources-media-unmount.conf
#   /etc/calamares/modules/sources-final.conf
#   /etc/calamares/modules/bootloader-config.conf
# Our inner zip is overlaid in Stage 6 so our settings.conf, branding, and
# customized module configs win — but the shellprocess .conf files survive.

# Ensure calamares-settings-debian is INSTALLED (not removed)
info "Ensuring calamares-settings-debian is installed..."
if ! dpkg -l calamares-settings-debian >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        calamares-settings-debian 2>&1 | tail -5 \
        || warn "Could not install calamares-settings-debian (continuing — shellprocess modules may be missing)"
else
    ok "calamares-settings-debian already installed"
fi

# Still remove ubuntu settings if present (genuinely conflicting on Debian)
if dpkg -l calamares-settings-ubuntu >/dev/null 2>&1; then
    info "Removing conflicting package: calamares-settings-ubuntu"
    DEBIAN_FRONTEND=noninteractive apt-get remove -y --purge calamares-settings-ubuntu \
        2>&1 | tail -3 || warn "Failed to remove calamares-settings-ubuntu"
fi

# ── Stage 5: install patched calamares ────────────────────────────────────
info "Installing patched Calamares package..."

DEBIAN_FRONTEND=noninteractive apt-get install -y "./${DEB_FILE}" 2>&1 | tail -10 \
    || die "Calamares package install failed"

INSTALLED_VER="$(dpkg-query -W -f='${Version}' calamares 2>/dev/null || true)"
if [[ "$INSTALLED_VER" == "$DEB_VERSION" ]]; then
    ok "Calamares ${DEB_VERSION} installed"
else
    die "Install verification failed (got version: '${INSTALLED_VER:-none}')"
fi

# ── Stage 6: deploy gLiTcH branding & module configs ──────────────────────
# Overlay our customized settings.conf, branding, and module configs ON TOP
# of the calamares-settings-debian defaults. Files we ship will overwrite
# the Debian ones; files we don't ship (the six shellprocess .conf files)
# remain in place and are picked up by our settings.conf exec sequence.
info "Deploying gLiTcH branding and module configurations (overlay)..."

mkdir -p /etc/calamares

unzip -oq "$INNER_ZIP" -d /etc/

# Move the desktop launcher to /tmp where the post-install steps expect it.
if [[ -f /etc/calamares-install-glitch.desktop ]]; then
    mv /etc/calamares-install-glitch.desktop /tmp/calamares-install-glitch.desktop
fi
ok "Configs deployed to /etc/calamares/ (overlay applied)"

# ── Stage 6.5: sanity-check shellprocess module configs ───────────────────
# Verify the six shellprocess module configs our settings.conf depends on
# actually exist. If any are missing, warn the user clearly so they can
# diagnose before launching Calamares (which would otherwise show
# "Calamares Initialization Failed").
info "Verifying shellprocess module configs are present..."
REQUIRED_CONFS=(
    /etc/calamares/modules/dpkg-unsafe-io.conf
    /etc/calamares/modules/dpkg-unsafe-io-undo.conf
    /etc/calamares/modules/sources-media.conf
    /etc/calamares/modules/sources-media-unmount.conf
    /etc/calamares/modules/sources-final.conf
    /etc/calamares/modules/bootloader-config.conf
)
MISSING=()
for f in "${REQUIRED_CONFS[@]}"; do
    [[ -f "$f" ]] || MISSING+=("$f")
done
if [[ ${#MISSING[@]} -eq 0 ]]; then
    ok "All required shellprocess module configs present"
else
    warn "Missing shellprocess module configs:"
    for f in "${MISSING[@]}"; do
        warn "    $f"
    done
    warn "Calamares may fail to initialize. Try: apt-get install --reinstall calamares-settings-debian"
fi

# ── Stage 7: post-install (icon + launcher) ───────────────────────────────
info "Running post-install steps..."

mkdir -p /usr/share/icons/
if [[ -f /etc/calamares/branding/debian/debian-logo.png ]]; then
    cp /etc/calamares/branding/debian/debian-logo.png /usr/share/icons/glitch-logo.png
    ok "Installed /usr/share/icons/glitch-logo.png"
else
    warn "Logo file not found at expected path; skipping icon copy"
fi

rm -f /usr/share/applications/calamares-install-debian.desktop

if [[ -f /tmp/calamares-install-glitch.desktop ]]; then
    cp /tmp/calamares-install-glitch.desktop \
       /usr/share/applications/calamares-install-glitch.desktop
    chown "${TARGET_USER}:${TARGET_GROUP}" \
       /usr/share/applications/calamares-install-glitch.desktop
    chmod +x /usr/share/applications/calamares-install-glitch.desktop
    ok "Installed /usr/share/applications/calamares-install-glitch.desktop"
else
    warn "Desktop launcher not found in /tmp; you may need to install it manually"
fi

command -v update-desktop-database >/dev/null && \
    update-desktop-database -q /usr/share/applications/ 2>/dev/null || true

# ── Done ──────────────────────────────────────────────────────────────────
echo
ok "gLiTcH Calamares installation complete"
echo
cat <<EOF
   ┌──────────────────────────────────────────────────────────┐
   │  Launch:    Applications menu → "Install gLiTcH Linux"   │
   │  Or run:    sudo calamares                               │
   │                                                          │
   │  To install to a loop device, ensure partition.conf has: │
   │      allowLoopDevices: true                              │
   │  Then:    sudo losetup -fP /path/to/disk.img             │
   │           sudo calamares                                 │
   └──────────────────────────────────────────────────────────┘

EOF

echo "sleep 6 && sudo calamares &" > /tmp/calmares-start
nohup bash /tmp/calmares-start 2>&1 &
exit
