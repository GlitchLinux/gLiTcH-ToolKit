#!/bin/bash
set -e

EXPECTED="/run/live/medium/live/filesystem.squashfs"
DEST="/filesystem.squashfs"
IMG_FILE="/tmp/live-medium-rw.img"
IMG_SIZE=10  # MB
MOUNT_POINT="/run/live/medium"
SYMLINK_DIR="$MOUNT_POINT/live"

# --- Step 1: Check if already in place ---
if [ -e "$EXPECTED" ]; then
    echo "[OK] $EXPECTED already exists - no action needed."
    exit 0
fi

# --- Step 2: Locate the squashfs ---
echo "[*] $EXPECTED not found - searching for squashfs..."

SOURCE=""
SEARCH_PATHS=(
    # Debian live-boot standard
    "/run/live/medium/filesystem.squashfs"
    "/run/live/medium/live/"
    # Debian rootfs variants
    "/run/live/rootfs/"
    # Ubuntu / Casper standard
    "/cdrom/casper/"
    "/run/live/medium/casper/"
    "/media/cdrom/casper/"
    "/isodevice/casper/"
    # Ubuntu minimal / subiquity
    "/cdrom/ubuntu/"
    "/run/live/medium/ubuntu/"
    # Older Ubuntu / fallback mounts
    "/cdrom/"
    "/media/cdrom/"
    # Generic ISO mount points
    "/run/live/medium/install/"
    "/run/live/medium/d-i/"
)

for path in "${SEARCH_PATHS[@]}"; do
    if [ -d "$path" ]; then
        match=$(find "$path" -maxdepth 1 -name "*.squashfs" -type f | head -n1)
        if [ -n "$match" ]; then
            SOURCE="$match"
            break
        fi
    elif [ -f "$path" ]; then
        SOURCE="$path"
        break
    fi
done

# --- Step 2b: Deep search as last resort ---
if [ -z "$SOURCE" ]; then
    echo "[*] Known paths exhausted - running deep search..."
    SOURCE=$(find /run/live /cdrom /media/cdrom /isodevice 2>/dev/null \
        -maxdepth 4 -name "*.squashfs" -type f | head -n1)
fi

if [ -z "$SOURCE" ]; then
    echo "[ERROR] No squashfs found in any known location."
    echo ""
    echo "  Searched:"
    echo "    Debian:  /run/live/medium/filesystem.squashfs"
    echo "             /run/live/medium/live/*.squashfs"
    echo "             /run/live/rootfs/*.squashfs"
    echo "    Ubuntu:  /cdrom/casper/*.squashfs"
    echo "             /run/live/medium/casper/*.squashfs"
    echo "             /cdrom/ubuntu/*.squashfs"
    echo "    Generic: /media/cdrom/, /isodevice/"
    echo "    Deep:    /run/live/ /cdrom/ /media/cdrom/ (4 levels)"
    exit 1
fi

echo "[*] Found squashfs at: $SOURCE"

# --- Step 3: Verify source is valid ---
if ! file "$SOURCE" | grep -qi "squashfs"; then
    echo "[ERROR] $SOURCE does not appear to be a valid squashfs file."
    exit 1
fi

SQ_SIZE=$(stat -c%s "$SOURCE" 2>/dev/null || echo 0)
echo "[*] Source size: $(( SQ_SIZE / 1024 / 1024 ))MB"

# --- Step 4: Summary before action ---
echo ""
echo "=== Plan ==="
echo "  Source:     $SOURCE"
echo "  Copy to:    $DEST"
echo "  Loop image: $IMG_FILE (${IMG_SIZE}MB ext4)"
echo "  Mount at:   $MOUNT_POINT"
echo "  Symlink:    $SYMLINK_DIR/filesystem.squashfs -> $DEST"
echo "============="
echo ""

# --- Step 5: Execute ---
echo "[*] Copying squashfs to $DEST"
cp "$SOURCE" "$DEST"

echo "[*] Creating ${IMG_SIZE}MB ext4 image"
dd if=/dev/zero of="$IMG_FILE" bs=1M count=$IMG_SIZE 2>/dev/null
mkfs.ext4 -F "$IMG_FILE" >/dev/null 2>&1

echo "[*] Setting up loop device"
LOOP_DEV=$(losetup -f)
losetup "$LOOP_DEV" "$IMG_FILE"

echo "[*] Mounting $LOOP_DEV to $MOUNT_POINT"
umount "$MOUNT_POINT" 2>/dev/null || true
mount "$LOOP_DEV" "$MOUNT_POINT"

echo "[*] Creating symlink directory"
mkdir -p "$SYMLINK_DIR"

echo "[*] Creating symlink -> $DEST"
ln -s "$DEST" "$SYMLINK_DIR/filesystem.squashfs"

# --- Step 6: Verify result ---
if [ -e "$EXPECTED" ]; then
    echo "[OK] Success - $EXPECTED is now in place."
else
    echo "[ERROR] Something went wrong - $EXPECTED still missing."
    exit 1
fi
