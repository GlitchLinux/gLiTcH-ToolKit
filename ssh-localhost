ssh-keygen -f '/home/x/.ssh/known_hosts' -R '192.168.0.198'

cat > "/tmp/ssh-localhost" << 'EOF'

#!/bin/bash

clear
echo " "
echo "1. Glitch-Server" > /tmp/ssh-local
echo "2. Glitch-Server x11" >> /tmp/ssh-local
cat /tmp/ssh-local | borderize
echo " "

read -p "   Select SSH Task [1-2]: " choice

case $choice in
    1)
        clear
	      ssh x@192.168.0.198
        ;;
    2)
        clear
        ssh -Y x@192.168.0.198 
        ;;
    *)
        clear && echo "Invalid Choice, Retry..." | borderize
        sleep 2
        bash /bin/ssh-localhost
        ;;
esac

EOF

sudo cp /tmp/ssh-localhost /bin/ssh-localhost
sudo chmod +x /bin/ssh-localhost
clear && xterm -e '/bin/ssh-localhost' &
