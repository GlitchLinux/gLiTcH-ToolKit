#!/bin/bash

sudo wget -O firefox-isolated "https://glitchlinux.wtf/FILES/GLITCH-SOFTWARE/FireFox-Isolated/linux-version/GCC-executable/firefox-isolated"
sudo mv firefox-isolated /usr/bin/firefox-isolated
sudo chmod +x /usr/bin/firefox-isolated
sudo wget -O /bin/counter https://raw.githubusercontent.com/GlitchLinux/gLiTcH-ToolKit/refs/heads/main/counter
sudo chmod +x /bin/counter 

cat > "/tmp/firefox-isolated.desktop" << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Firefox Isolated
Exec=/usr/bin/firefox-isolated
Icon=/usr/share/icons/firefox-isolated.png
Terminal=false
Categories=Network;WebBrowser;
EOF

sudo mv /tmp/firefox-isolated.desktop /usr/share/applications/firefox-isolated.desktop
sudo chmod +x /usr/share/applications/firefox-isolated.desktop

OUT_FILE="firefox-isolated.png"
EXPECTED_SIZE=20126

if [[ -e "$OUT_FILE" ]]; then
    printf "> '%s' already exists. Overwrite? [y/N] " "$OUT_FILE"
    read -r ANS
    case "$ANS" in
        [Yy]*) ;;
        *) echo "> aborted"; exit 1 ;;
    esac
fi

echo "> rebuilding '$OUT_FILE'..."
