"echo 'nohup calamares-glitch-launcher 2>&1 &' >> /tmp/sudo-launcher.tmp" >> /usr/local/bin/calamares-glitch-launcher
"echo 'disown && exit' >> /tmp/sudo-launcher.tmp" >> /usr/local/bin/calamares-glitch-launcher


